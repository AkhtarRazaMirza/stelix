# ==========================================================================
# Stelix frontend environment variables
# --------------------------------------------------------------------------
# Copy this file to `client/.env.local` and fill in real values.
# NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here.
# ==========================================================================

# Base URL of the backend API (include the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Google OAuth client ID (public — used by the Google sign-in button).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id
