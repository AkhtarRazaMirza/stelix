# ==========================================================================
# Stelix backend environment variables
# --------------------------------------------------------------------------
# Copy this file to `server/.env` and fill in real values. NEVER commit the
# real .env file. All variables without a default are REQUIRED and validated
# at startup (see src/env.ts) — the server will refuse to boot if any are
# missing, with a per-variable error message.
# ==========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=8000
# One of: error | debug | info (optional)
LOGGER_LEVEL=info

# --- Database (PostgreSQL / Neon) ----------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/stelix

# --- URLs / CORS ---------------------------------------------------------
# Public URL of the frontend app (used for OAuth redirects back to the UI).
APP_URL=http://localhost:3000
# Comma-separated list of allowed browser origins. No wildcards.
CORS_ORIGIN=http://localhost:3000

# --- JWT secrets (use long, random, unique values per secret) ------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_TOKEN_SECRET=replace-with-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_IN=7d
JWT_EMAIL_VARIFICATION_TOKEN_SECRET=replace-with-long-random-string
JWT_EMAIL_VARIFICATION_TOKEN_EXPIRES_IN=1h
JWT_PASSWORD_RESET_SECRET=replace-with-long-random-string
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# --- Cookie configuration (environment-driven; see src/config/cookie.ts) --
# Leave COOKIE_DOMAIN unset for localhost, Render *.onrender.com, and Vercel
# preview URLs (host-only cookie). Set it in production to share the auth
# cookie across subdomains, e.g. .stelix.akhtarraza.in
# COOKIE_DOMAIN=.your-domain.com
# sameSite: "lax" for same-site, "none" for cross-site frontend/API (prod).
# Defaults: "none" in production, "lax" otherwise.
# COOKIE_SAMESITE=lax
# secure: "true"/"false". Defaults to true in production, false otherwise.
# COOKIE_SECURE=false

# --- Google OAuth --------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Corsair (Gmail / Google Calendar integration) -----------------------
CORSAIR_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/callback
CORSAIR_DEV_KEY=your-corsair-dev-key
# Key-encryption key used by Corsair to encrypt stored integration tokens.
CORSAIR_KEK=your-corsair-kek

# --- Cloudinary (avatar uploads) -----------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Resend (transactional email) ----------------------------------------
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=no-reply@your-domain.com

# --- AI providers --------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key
